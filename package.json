{
  "name": "mallow",
  "private": true,
  "version": "0.13.0",
  "description": "A lightweight desktop Markdown / config-file viewer (Tauri v2).",
  "license": "MIT",
  "author": "Takuya Otani <takuya.otani@serenebach.net>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serendipitynz/mallow.git"
  },
  "homepage": "https://github.com/serendipitynz/mallow#readme",
  "bugs": "https://github.com/serendipitynz/mallow/issues",
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:ci": "biome ci",
    "format": "biome format --write",
    "tauri": "tauri",
    "notices": "node scripts/gen-third-party-notices.mjs",
    "release": "node scripts/release-version.mjs"
  },
  "dependencies": {
    "@marp-team/marpit": "^3.2.3",
    "@marp-team/marpit-svg-polyfill": "^2.1.0",
    "@shikijs/markdown-it": "^4.6.0",
    "@tauri-apps/api": "~2.12.4",
    "@tauri-apps/plugin-dialog": "~2.8.4",
    "@tauri-apps/plugin-opener": "~2.7.3",
    "@tauri-apps/plugin-process": "~2.4.0",
    "@tauri-apps/plugin-store": "~2.5.1",
    "@tauri-apps/plugin-updater": "~2.14.1",
    "@tauri-apps/plugin-window-state": "~2.5.0",
    "github-slugger": "^2.0.0",
    "json5": "^2.2.3",
    "jsonc-parser": "^3.3.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-emoji": "^3.1.0",
    "markdown-it-github-alerts": "^1.0.1",
    "mermaid": "^11.17.2",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.6.0",
    "smol-toml": "^1.9.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@tauri-apps/cli": "~2.12.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "sass": "^1.108.1",
    "typescript": "~5.8.3",
    "vite": "^7.3.7",
    "vitest": "^5.1.0"
  }
}
