{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for every app window: the configured window and the w<n> windows created at runtime",
  "windows": ["main", "w*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "opener:default",
    "dialog:default",
    "store:default",
    "updater:default",
    "process:allow-restart"
  ]
}
